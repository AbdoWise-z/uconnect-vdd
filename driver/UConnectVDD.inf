;
; UConnectVDD.inf - uConnect virtual display driver
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=uconnectvdd.cat
DriverVer = ; set by stampinf

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...17134

[Standard.NT$ARCH$.10.0...17134]
%DeviceName%=UConnectVDD_Install, Root\uConnectVDD

[SourceDisksFiles]
UConnectVDD.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[UConnectVDD_Install.NT]
CopyFiles=UMDriverCopy

[UConnectVDD_Install.NT.hw]
AddReg = UConnectVDD_HardwareDeviceSettings

[UConnectVDD_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "UConnectVDDGroup"
; SYSTEM and Administrators: full access. Interactive users (the app runs
; as one): read and write, which is what the control IOCTLs need.
HKR,, "Security",, "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[UConnectVDD_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[UConnectVDD_Install.NT.Wdf]
UmdfService=UConnectVDD,UConnectVDD_Install
UmdfServiceOrder=UConnectVDD
UmdfKernelModeClientPolicy = AllowKernelModeClients

[UConnectVDD_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\UConnectVDD.dll
UmdfExtensions = IddCx0102

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys

[DestinationDirs]
UMDriverCopy=13 ; the driver store

[UMDriverCopy]
UConnectVDD.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="uConnect"
DiskName = "uConnect Virtual Display Installation Disk"
DeviceName="uConnect Virtual Display Adapter"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
